{
  "name": "cbtw_test_framework",
  "version": "1.0.0",
  "description": "This is an automation framework",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:ui": "cucumber-js --tags '@ui'",
    "report:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:open": "allure open reports/allure-report",
    "test:report": "npm test && npm run report:generate && npm run report:open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielalvaradog/cbtw_test_framework.git"
  },
