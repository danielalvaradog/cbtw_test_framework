  "bugs": {
    "url": "https://github.com/danielalvaradog/cbtw_test_framework/issues"
  },
  "homepage": "https://github.com/danielalvaradog/cbtw_test_framework#readme",
  "devDependencies": {
    "@esbuild-kit/cjs-loader": "^2.4.4",
    "@types/cucumber": "^6.0.1",
    "@types/node": "^22.14.1",
    "cucumber-html-reporter": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "playwright": "^1.51.1"
  }
}
